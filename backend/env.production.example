CI_ENVIRONMENT = production
app.baseURL = 'https://app.wheelsturn.co.za/'
app.forceGlobalSecureRequests = true

# Replace CPANELUSER with your cPanel username, and set the password you chose in MySQL Databases
database.default.hostname = localhost
database.default.database = CPANELUSER_wheelsturn
database.default.username = CPANELUSER_wtapp
database.default.password = 'CHANGE_ME'
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port = 3306

# Leave these two empty: the installer (gms:install) generates them automatically
encryption.key =
jwt.secret =
