{
  "expo": {
    "name": "Wheelsturn",
    "slug": "wheelsturngms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wheelsturn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "za.co.wheelsturn.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "za.co.wheelsturn.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wheelsturn uses the camera to photograph vehicles, record inspection videos and scan part barcodes and VINs.",
          "microphonePermission": "Wheelsturn records sound with inspection videos so customers can hear the fault.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wheelsturn lets you attach photos and proof-of-payment slips from your library.",
          "cameraPermission": "Wheelsturn uses the camera to photograph vehicles and payment slips.",
          "microphonePermission": "Wheelsturn records sound with inspection videos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9b1631",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://app.wheelsturn.co.za/api/v1",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bbf3b22d-843f-462b-bf7c-0669b4696156"
      }
    },
    "owner": "promptaidzas-team"
  }
}
